<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Matched to the supplied Stardew Valley 1.6.15 / SMAPI 4.5.2 files. -->
    <TargetFramework Condition="'$(GameTargetFramework)' == ''">net6.0</TargetFramework>
    <TargetFramework Condition="'$(GameTargetFramework)' != ''">$(GameTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BuildingRotation.Smapi</AssemblyName>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BuildingRotation.Runtime/BuildingRotation.Runtime.csproj" />
    <ProjectReference Include="../BuildingRotation.Data/BuildingRotation.Data.csproj" />
    <Reference Include="StardewModdingAPI"><HintPath>$(GamePath)/StardewModdingAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Stardew Valley"><HintPath>$(GamePath)/Stardew Valley.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SMAPI.Toolkit.CoreInterfaces"><HintPath>$(GamePath)/smapi-internal/SMAPI.Toolkit.CoreInterfaces.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoGame.Framework"><HintPath>$(GamePath)/MonoGame.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="xTile"><HintPath>$(GamePath)/xTile.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="StardewValley.GameData"><HintPath>$(GamePath)/StardewValley.GameData.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)/smapi-internal/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="VerifyGameReferences" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GamePath)' == ''" Text="Set GamePath to the matching game/SMAPI assembly folder. This diagnostic project cannot be built from Content alone." />
    <Error Condition="!Exists('$(GamePath)/StardewModdingAPI.dll')" Text="Matching StardewModdingAPI.dll is missing." />
    <Error Condition="!Exists('$(GamePath)/Stardew Valley.dll')" Text="Matching Stardew Valley.dll is missing." />
    <Error Condition="!Exists('$(GamePath)/smapi-internal/SMAPI.Toolkit.CoreInterfaces.dll')" Text="Matching smapi-internal/SMAPI.Toolkit.CoreInterfaces.dll is missing." />
  </Target>
</Project>
